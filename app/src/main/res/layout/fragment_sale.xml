<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/myBackground"
    tools:context=".sales.ui.view.SaleFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Encabezado -->
            <!--ajustar el tamano responsive yua que al voltear el cel se hace
            mas pequeño el titulo y los botones-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                >

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnReturnSalesFrag"
                    style="@style/AppCompatImageButton_Rounded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:paddingVertical="5dp"
                    android:paddingLeft="10dp"
                    android:src="@drawable/baseline_arrow_back_ios_24"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tvTitelSales"
                    android:layout_width="310dp"
                    android:layout_height="match_parent"
                    android:text="@string/title_new_sales"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAddProductListSales"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="3dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/baseline_add_24"/>

            </LinearLayout>

            <!-- Sección de productos -->
            <TextView
                android:text="Productos"
                android:textSize="18sp"
                android:textColor="#121417"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <!-- Puedes repetir el bloque de producto cambiando los textos -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSalesProductList"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="5dp"
                />
            <!-- Resumen -->
            <TextView
                android:text="Resumen"
                android:textSize="18sp"
                android:textColor="#121417"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Subtotal"
                        android:textColor="#687582"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/subTotalSalesFrag"
                        android:text="$100.00"
                        android:textColor="#121417"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Total"
                        android:textColor="#687582"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalSalesFrag"
                        android:text="$100.00"
                        android:textColor="#121417"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón de Finalizar compra -->
            <Button
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Finalizar Compra"
                android:backgroundTint="#d7e5f3"
                android:textColor="#121417"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>


</FrameLayout>