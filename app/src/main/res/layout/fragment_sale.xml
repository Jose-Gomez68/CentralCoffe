            <!-- Puedes repetir el bloque de producto cambiando los textos -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSalesProductList"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="5dp"
                />
            <!-- Resumen -->
            <TextView
                android:text="Resumen"
                android:textSize="18sp"
                android:textColor="#121417"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Subtotal"
                        android:textColor="#687582"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/subTotalSalesFrag"
                        android:text="$100.00"
                        android:textColor="#121417"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Total"
                        android:textColor="#687582"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalSalesFrag"
                        android:text="$100.00"
                        android:textColor="#121417"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón de Finalizar compra -->
            <Button
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Finalizar Compra"
                android:backgroundTint="#d7e5f3"
                android:textColor="#121417"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>


