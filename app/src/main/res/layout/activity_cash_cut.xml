<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/myBackground"
    tools:context=".reports.ui.view.CashCutActivity"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/ReportLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnReturnReportCashCut"
                        style="@style/AppCompatImageButton_Rounded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingVertical="5dp"
                        android:paddingLeft="10dp"
                        android:src="@drawable/baseline_arrow_back_ios_24"
                        android:textAlignment="center" />


                    <!-- TODO: Update blank fragment layout -->
                    <TextView
                        android:id="@+id/tvTitleEditProduct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingRight="35dp"
                        android:text="Corte de Caja"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/EditProductLinearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ReportLinearLayout"
                    app:layout_constraintVertical_bias="0.060000002">

                    <!-- <EditText
                        android:id="@+id/etReportDateCashCut"
                        style="@style/EditText_Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginTop="10dp"
                        android:hint="Selecciona la Fecha y hora del corte"
                        android:inputType="date"
                        android:focusable="true"
                        android:editable="true"
                        android:cursorVisible="false"
                        android:paddingHorizontal="10dp" />-->

                    <TextView
                        android:id="@+id/etReportDateCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginTop="10dp"
                        style="@style/EditText_Rounded"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:hint="Selecciona la Fecha del corte"
                        android:inputType="date"
                        android:focusable="true"
                        android:editable="true"
                        android:cursorVisible="false"
                        android:paddingHorizontal="10dp" />

                    <Spinner
                        android:id="@+id/spinnerTurno"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="40dp"
                        android:layout_marginTop="10dp"
                        style="@style/EditText_Rounded"
                        android:spinnerMode="dropdown"
                        android:paddingHorizontal="12dp"/>

                    <TextView
                        android:id="@+id/tvErrorSp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/red"
                        android:text="error"
                        android:visibility="invisible"
                        />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReportCaja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Cargar"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvTitleSucCashCut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sucursal Principal"
                        android:visibility="invisible"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginTop="30dp"
                        android:paddingStart="10dp"
                    />

                    <TextView
                        android:id="@+id/tvSubTitleSucCashCut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:layout_marginTop="5dp"
                        android:paddingStart="10dp"
                        android:text="Resumen de Pagos"
                        android:textFontWeight="500"
                        />

                    <LinearLayout
                        android:id="@+id/lyTitlePaymentCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Detalle"
                            android:textStyle="bold"
                            android:layout_weight="3"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Monto"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:paddingEnd="10dp"
                            />

                    </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyTCreditCashCut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:paddingStart="10dp"
                        android:text="Tarjeta Credito"
                        android:layout_weight="3"

                        />

                    <TextView
                        android:id="@+id/tvCreditPayReportCashCut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:paddingStart="10dp"
                        android:text="300,000"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        />

                </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyTDebitCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Tarjeta Debito"
                            android:layout_weight="3"

                            />

                        <TextView
                            android:id="@+id/tvDebitCardPayReportCashCut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="300,000"
                            android:layout_weight="1"
                            android:paddingEnd="10dp"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyTransfCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Transferencia"
                            android:layout_weight="3"

                            />

                        <TextView
                            android:id="@+id/tvTransferReportCashCut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="300,000"
                            android:layout_weight="1"
                            android:paddingEnd="10dp"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyEfectiveCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Efectivo"
                            android:layout_weight="3"

                            />

                        <TextView
                            android:id="@+id/tvEfectiReportCashCut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="300,000"
                            android:layout_weight="1"
                            android:paddingEnd="10dp"
                            />

                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/dvPayment"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="10dp"
                        android:visibility="invisible"
                        android:paddingStart="10dp"
                        app:dividerColor="#141313"
                        android:backgroundTint="#141313"
                        android:layout_marginVertical="8dp"
                        />

                    <LinearLayout
                        android:id="@+id/lyTotalCashCut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="Total"
                            android:layout_weight="3"

                            />

                        <TextView
                            android:id="@+id/tvTotalReportCashCut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingStart="10dp"
                            android:text="600,000"
                            android:layout_weight="1"
                            android:paddingEnd="10dp"
                            />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnExportar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Exportar en Xml"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        />

                    <!--<androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReportSales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Reporte de Ventas"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReportProduct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Reporte de Productos"
                        android:textColor="@color/white"
                        android:textSize="15sp" />-->

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>