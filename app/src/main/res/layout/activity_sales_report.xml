<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/myBackground"
    tools:context=".reports.ui.view.SalesReportActivity"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/ReportLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnReturnReportCashCut"
                        style="@style/AppCompatImageButton_Rounded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingVertical="5dp"
                        android:paddingLeft="10dp"
                        android:src="@drawable/baseline_arrow_back_ios_24"
                        android:textAlignment="center" />


                    <!-- TODO: Update blank fragment layout -->
                    <TextView
                        android:id="@+id/tvTitleEditProduct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingRight="35dp"
                        android:text="Reporte de Ventas"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/EditProductLinearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ReportLinearLayout"
                    app:layout_constraintVertical_bias="0.060000002">


                    <TextView
                        android:id="@+id/etReportDateSalesReport"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginTop="10dp"
                        style="@style/EditText_Rounded"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:hint="Selecciona la Fecha de Inicio"
                        android:inputType="date"
                        android:focusable="true"
                        android:editable="true"
                        android:cursorVisible="false"
                        android:paddingHorizontal="10dp" />

                    <TextView
                        android:id="@+id/etReportDate2SalesReport"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginTop="10dp"
                        style="@style/EditText_Rounded"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:hint="Selecciona la Fecha de Fin"
                        android:inputType="date"
                        android:focusable="true"
                        android:editable="true"
                        android:cursorVisible="false"
                        android:paddingHorizontal="10dp" />

                    <!--<Spinner
                        android:id="@+id/spinnerTurno"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="40dp"
                        android:layout_marginTop="10dp"
                        style="@style/EditText_Rounded"
                        android:spinnerMode="dropdown"
                        android:paddingHorizontal="12dp"/>
-->
                    <!--<TextView
                        android:id="@+id/tvErrorSp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/red"
                        android:text="error"
                        android:visibility="invisible"
                        />-->

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReporSalesReport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Cargar"
                        android:textColor="@color/white"
                        android:textSize="15sp" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSalesReportList"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"

                        android:layout_marginTop="10dp"
                        />
                    <!--android:scrollbars="vertical|horizontal"-->

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnExportar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@color/blue"
                        android:paddingHorizontal="60dp"
                        android:text="Exportar en Xml"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>